{
  "name": "scrolly-maplibre",
  "version": "0.2.2",
  "description": "Config-driven scrollytelling maps with MapLibre GL JS and Scrollama.",
  "main": "./dist/core.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build",
    "preview": "http-server dist",
    "start": "npm run build && npm run preview",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "test:types": "tsc --project test/types/tsconfig.json"
  },
  "keywords": [
    "maplibre",
    "scrollama",
    "scrollytelling",
    "maps",
    "storytelling",
    "deck.gl"
  ],
  "author": "Jesse Friend",
  "devDependencies": {
    "clean-css": "^5.3.3",
    "http-server": "^14.1.1",
    "playwright-core": "1.64.1",
    "rollup": "^4.41.0",
    "terser": "^5.39.2",
    "typescript": "5.9.3"
  },
  "private": false,
  "license": "MIT",
  "type": "module",
  "module": "./dist/core.js",
  "types": "./dist/types/core.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/core.d.ts",
      "import": "./dist/core.js"
    },
    "./core": {
      "types": "./dist/types/core.d.ts",
      "import": "./dist/core.js"
    },
    "./story": {
      "types": "./dist/types/story.d.ts",
      "import": "./dist/story.js"
    },
    "./auto": {
      "types": "./dist/types/auto.d.ts",
      "import": "./dist/auto.js"
    },
    "./core.css": "./dist/styles/core.css",
    "./story.css": "./dist/styles/story.css",
    "./loader.css": "./dist/styles/loader.min.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.js",
    "dist/chunks",
    "dist/types",
    "dist/styles",
    "dist/js/bundle.min.js",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/auto.js",
    "./dist/js/bundle.min.js",
    "**/*.css"
  ],
  "unpkg": "dist/js/bundle.min.js",
  "jsdelivr": "dist/js/bundle.min.js",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OroraTech/scrolly-maplibre.git"
  }
}
